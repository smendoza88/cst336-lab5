<!DOCTYPE html>
<html lang="en">
<!-- Icons are from https://feathericons.com/ -->

<%- include('partials/header') %>
  <%- include('partials/nav') %>

    <body class="">
      <div class="container py-5">
        <div class="row justify-content-center">
          <div class="col-lg-8 col-xl-7">

            <!-- ============ SEARCH CARD ============ -->
            <div class="card border-0 shadow rounded-4 p-4 p-md-5">
              <div class="text-center mb-4">
                <h1 class="fw-bold d-inline-flex align-items-center gap-2">
                  <!-- Open book -->
                  <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#7C3AED" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
                    <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
                  </svg>
                  Quote Finder
                </h1>
                <p class="text-secondary mb-0">
                  Discover quotes by keyword, author, category, or popularity.
                </p>
              </div>

              <!-- Single endpoint, instead of mutiple buttons one search button.
                The search endpoint will handle the param logic 
          -->
              <form action="/quotes/search" method="GET">

                <div class="mb-3">
                  <label for="keyword" class="form-label fw-semibold">Keyword</label>
                  <input type="text" class="form-control form-control-lg" id="keyword" name="keyword"
                    placeholder="e.g. freedom, liberty, love"
                    value="<%= typeof filters !== 'undefined' && filters.keyword ? filters.keyword : '' %>">
                </div>

                <div class="mb-3">
                  <label for="author" class="form-label fw-semibold">Author</label>
                  <select class="form-select form-select-lg" id="author" name="author">
                    <option value="">All Authors</option>
                    <% if (typeof authors !=='undefined' ) { for (const a of authors) { %>

                      <option value="<%= a.authorid %>" <%=(filters.author &&
                        String(filters.author)===String(a.authorId)) ? 'selected' : '' %>>


                        <%= a.authorName %>
                      </option>
                      <% } } %>
                  </select>
                </div>

                <div class="mb-3">
                  <label for="category" class="form-label fw-semibold">Category</label>
                  <select class="form-select form-select-lg" id="category" name="category">
                    <option value="">All categories</option>
                    <% if (typeof categories !=='undefined' ) { categories.forEach(function(c) { %>
                      <option value="<%= c.category %>" <%=(typeof filters !=='undefined' &&
                        String(filters.category)===String(c.category)) ? 'selected' : '' %>>
                        <%= c.category %>
                      </option>
                      <% }); } %>
                  </select>
                </div>

                <div class="mb-3">
                  <label class="form-label fw-semibold">Likes Range</label>
                  <div class="row g-2 align-items-center">
                    <div class="col">
                      <input type="number" class="form-control form-control-lg" name="minLikes" min="0"
                        placeholder="Min"
                        value="<%= typeof filters !== 'undefined' && filters.minLikes ? filters.minLikes : '' %>">
                    </div>
                    <div class="col-auto text-secondary">to</div>
                    <div class="col">
                      <input type="number" class="form-control form-control-lg" name="maxLikes" min="0"
                        placeholder="Max"
                        value="<%= typeof filters !== 'undefined' && filters.maxLikes ? filters.maxLikes : '' %>">
                    </div>
                  </div>
                </div>

                <button type="submit"
                  class="btn btn-primary btn-lg w-100 mt-3 d-flex align-items-center justify-content-center gap-2">
                  <!-- magnifying glass svg -->
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5"
                    stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8" />
                    <path d="M21 21l-4.3-4.3" />
                  </svg>
                  Search Quotes
                </button>
              </form>
            </div>

            <!-- ============ Quote  results.  ============ -->
            <% if (typeof quotes !=='undefined' ) { %>
              <h2 class="h4 fw-bold mt-5 mb-3">
                Results <span class="text-primary">(<%= quotes.length %>)</span>
              </h2>

              <% if (quotes.length===0) { %>
                <div class="card border-0 border-dashed text-center text-secondary p-4 rounded-4">
                  No quotes matched your filters. Try widening your search.
                </div>
                <% } %>

                  <% quotes.forEach(function(q) { %>
                    <div class="card quote-card border-0 shadow-sm rounded-4 mb-3">
                      <div class="card-body p-4">
                        <p class="quote-text mb-3">&ldquo;<%= q.quote %>&rdquo;</p>
                        <a href="#" id="<%= q.authorid %>" class="author-link"> <p class="text-end fw-semibold mb-3" style="color: var(--bs-primary);">
                          &mdash; <%= q.authorName %>
                            </p>
                        </a>
                        <div class="d-flex justify-content-between align-items-center border-top pt-3">
                          <span class="badge rounded-pill badge-book fw-semibold">
                            <%= q.category %>
                          </span>
                          <span class="fw-semibold d-inline-flex align-items-center gap-1">
                            <!-- Likes heart svg -->
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="#EF4444" stroke="#EF4444"
                              stroke-width="2">
                              <path
                                d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1L12 21l7.7-7.6 1.1-1a5.5 5.5 0 0 0 0-7.8z" />
                            </svg>
                            <%= q.likes %> Likes
                          </span>
                        </div>
                      </div>
                    </div>
                    <% }); %>
                      <% } %>

          </div>
        </div>
      </div>

      <!-- Modal pop up -->
      <div class="modal" tabindex="-1" id="authorModal">
        <div class="modal-dialog">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title">Author Information</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <div id="authorInfo"></div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
              <button type="button" class="btn btn-primary">Save changes</button>
            </div>
          </div>
        </div>
      </div>

      <script src="/js/scripts.js"></script>
      <%- include('partials/footer') %>
    </body>


</html>